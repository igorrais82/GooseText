{
  "name": "goosetext",
  "productName": "GooseText",
  "version": "4.0.0",
  "private": true,
  "description": "GooseText — заметки, конспекты, сценарии, рисунки и напоминания с гусем-помощником",
  "author": "GooseText",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5180",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --host 127.0.0.1 --port 5181",
    "app": "node server/serve.mjs",
    "desktop": "electron .",
    "desktop:dev": "electron .",
    "desktop:pack": "vite build && electron-builder --win --dir",
    "desktop:dist": "vite build && electron-builder --win",
    "android:sync": "vite build && cap sync android",
    "android:apk": "vite build && cap sync android && cd android && gradlew assembleRelease"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@capacitor/android": "^7.6.10",
    "@capacitor/cli": "^7.6.10",
    "@capacitor/core": "^7.6.10",
    "@capacitor/filesystem": "^7.1.9",
    "@capacitor/share": "^7.0.4",
    "@electron/asar": "^4.3.1",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.2"
  },
  "build": {
    "appId": "com.goosetext.desktop",
    "productName": "GooseText",
    "copyright": "GooseText",
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "assets/goosetext.ico",
      "package.json"
    ],
    "asar": true,
    "win": {
      "icon": "assets/goosetext.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "GooseText",
      "artifactName": "GooseText-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "GooseText-${version}-portable.exe"
    }
  }
}
